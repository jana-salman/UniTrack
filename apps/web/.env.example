# Web owns browser authentication and gateway calls. It has no DATABASE_URL.
# Copy this file to .env.local and obtain real values privately.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated domains, without @
ALLOWED_EMAIL_DOMAINS=

INTERNAL_JWT_SECRET=

# HTTPS origins only in deployment, with no path/query/credentials.
USERS_SERVICE_URL=

EQUIPMENT_SERVICE_URL=

LOANS_SERVICE_URL=
