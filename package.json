{
  "name": "unitrack",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@unitrack/web",
    "start": "npm run start --workspace=@unitrack/web",
    "typegen": "npm run typegen --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build:packages && npm run build --workspace=@unitrack/web",
    "build:packages": "npm run build --workspace=@unitrack/contracts && npm run build --workspace=@unitrack/internal-auth",
    "pretest": "npm run build:packages",
    "pretypecheck": "npm run build:packages"
  }
}
