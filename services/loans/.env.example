# Must match Web, Users, and Equipment.
INTERNAL_JWT_SECRET=

# Loans-specific direct or session-pooled login. Transaction pooling is unsafe
# because the return workflow holds a session advisory lock across commits.
DATABASE_URL=
# HTTPS Equipment service origin only, with no path/query/credentials.
EQUIPMENT_SERVICE_URL=
# Set to confirmed only after verifying direct/session connection affinity.
LOANS_DATABASE_SESSION_AFFINITY=
